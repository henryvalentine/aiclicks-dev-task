[Unit]
Description=AIClicks Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiclicks
Group=aiclicks
WorkingDirectory=/opt/aiclicks/app/frontend
Environment=NODE_ENV=production
Environment=PORT=3340
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3340
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
